{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "elky-studios-media-api",
  "main": "./media-worker.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "elky-studios-media"
    }
  ],
  "vars": {
    "SUPABASE_ISSUER": "https://dtyhfmrqswonvxfjdakn.supabase.co/auth/v1",
    "ADMIN_USER_ID": "69770c28-7c21-4edb-8656-9198fbd02df4",
    "ALLOWED_ORIGINS": "https://ingjair.github.io,https://elky-studios.docfanton.chatgpt.site,http://localhost:3000"
  }
}
